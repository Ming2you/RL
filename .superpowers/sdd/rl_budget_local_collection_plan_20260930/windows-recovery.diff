+def load_physical(path, settings):
+    # Called only by the parent's explicit migration command, or mocked in synthetic tests.
+    from budget_env import BudgetEnv
+    rt = lr.boot(lr.DEFAULT_SNAPSHOT, settings["cpu_mask"])
