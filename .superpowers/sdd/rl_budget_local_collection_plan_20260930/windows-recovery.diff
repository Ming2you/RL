+        for path in (OLD_ROOT / KEY / "sessions").iterdir():
+            publish_file(path, slot / "sessions" / path.name)
+        history = [dict(r, launcher=None) for r in prior]
+        lr.durable_save(outputs / ".ownership/reservations.json", history)
