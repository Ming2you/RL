+            return outcome
+        except BaseException as exc:
+            s.save_once(output / "failures" / f"{session}.json", dict(error=f"{type(exc).__name__}: {exc}",
+                session_id=session, control_steps=steps, preserve_all_orphans=True))
+            raise
+        finally:
+            try:
+                if env is not None:
