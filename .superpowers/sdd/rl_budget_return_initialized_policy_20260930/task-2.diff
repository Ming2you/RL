+def session_timing(output, settings, required=()):
+    ids = sorted(set(required) | set(session_ids(output)))
+    known, unknown, hashes = 0., [], {}
+    for sid in ids:
+        if len(sid) != 32 or any(c not in "0123456789abcdef" for c in sid):
