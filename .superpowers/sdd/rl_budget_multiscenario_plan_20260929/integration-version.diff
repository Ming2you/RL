+class _ConstantCritic(nn.Module):
+    def __init__(self, values):
+        super().__init__()
+        self.values = nn.Parameter(torch.tensor(values, dtype=torch.float32).reshape(-1, 1))
+
+    def forward(self, inputs):
+        return self.values.expand(len(inputs), 1)
