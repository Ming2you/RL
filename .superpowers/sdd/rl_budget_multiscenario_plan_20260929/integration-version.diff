+    learner.critics = nn.ModuleList([_ConstantCritic([100]), _ConstantCritic([200])])
+    rewards = torch.tensor([[-1000.0], [-2.0], [-3.0], [-4.0]], requires_grad=True)
+    next_obs = torch.ones((4, 3), requires_grad=True)
