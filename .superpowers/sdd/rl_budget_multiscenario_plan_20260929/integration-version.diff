+    restored = TD3(3, seed=999, hidden=8)
+    restored.load_state_dict(learner.state_dict())
+    _equal(learner.state_dict(), restored.state_dict())
+    assert learner.update() == restored.update()
+    _equal(learner.state_dict(), restored.state_dict())
+
